# Copy to .env and edit. Never commit .env to GitHub.
SITE_NAME="The Seasoned Book Editor"
SITE_URL="http://localhost:8000"
# Local development (no Docker): a SQLite file.
DATABASE_URL="sqlite:///./dev.db"
# Production server: use PostgreSQL instead, for example
# DATABASE_URL="postgresql+psycopg2://site:<POSTGRES_PASSWORD>@db:5432/site"
SECRET_KEY="replace-with-a-long-random-string"
ADMIN_USER="chinasa"
ADMIN_PASSWORD="replace-with-a-strong-password"
# Optional: email alerts for new enquiries (leave blank to skip)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
NOTIFY_TO=""

# Production server only (docker compose reads these automatically)
DOMAIN="yourdomain.com"
POSTGRES_PASSWORD="replace-with-a-long-random-password"
